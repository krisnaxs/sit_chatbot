APP_NAME=SIAM
APP_ENV=production
APP_KEY=base64:FKHzFkxS6apnxf+gcDYbsLdnzhuUJsVxH+wN0yRlOVc=
APP_DEBUG=false
APP_URL=http://10.8.22.124:8000/
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ============================================
# LOG — daily rotation, hindari file membengkak
# ============================================
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sit
DB_USERNAME=root
DB_PASSWORD=
DB_AI_USERNAME=ai_readonly
DB_AI_PASSWORD=ai_readonly

# ============================================
# OLLAMA (Local AI Chatbot)
# ============================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
OLLAMA_INTENT_TIMEOUT=8
OLLAMA_USE_FORMATTER=false

# ============================================
# SCOUT / TNTSearch
# ============================================
SCOUT_DRIVER=tntsearch
TNTSEARCH_FUZZINESS=true

# ============================================
# SESSION
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ============================================
# MISC
# ============================================
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# ============================================
# FILE STORAGE
# ============================================
FILESYSTEM_DISK=public

# ============================================
# CACHE — pilih SATU store saja
# ============================================
CACHE_STORE=redis
# CACHE_PREFIX=

# ============================================
# REDIS
# ============================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ============================================
# MAIL
# ============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sit.local"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# AWS (kosong, tidak dipakai)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# VITE
# ============================================
VITE_APP_NAME="${APP_NAME}"
